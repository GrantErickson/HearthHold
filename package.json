{
  "name": "hearthold",
  "private": true,
  "version": "1.0.0",
  "description": "Carry, sell, build and defend: a low-poly medieval wave-defense game for the browser.",
  "homepage": "https://granterickson.github.io/HearthHold/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "app:sync": "npm run build && cap sync",
    "app:ios": "cap open ios",
    "app:android": "cap open android",
    "version:ci": "node scripts/app-version.mjs --write",
    "icons": "npx --yes @capacitor/assets@3.0.5 generate --ios --android --iconBackgroundColor \"#1f3a2b\" --iconBackgroundColorDark \"#1f3a2b\" --splashBackgroundColor \"#1f3a2b\" --splashBackgroundColorDark \"#1f3a2b\""
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/lilita-one": "^5.3.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/three": "0.170.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.6"
  }
}
