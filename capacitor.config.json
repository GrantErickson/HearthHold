{
  "appId": "net.micapeak.HearthHold",
  "appName": "HearthHold",
  "webDir": "dist",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "androidScaleType": "CENTER_CROP"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  },
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "allowMixedContent": false
  }
}
